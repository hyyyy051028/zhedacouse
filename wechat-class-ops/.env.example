# ===== 运行模式 =====
# mock: 本地假数据，全流程可跑（默认）
# live: 走飞书多维表格真实接口，需要下面的 App ID / Secret
FEISHU_MODE=mock

# ===== 飞书自建应用（live 模式必填）=====
# 开发者后台 > 应用详情 > 凭证与基础信息
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 多维表格 app_token（即 /base/xxxx 里的那串）
FEISHU_BASE_TOKEN=YwhGb2QWlav8YLscSmochPttns9

# ===== 表名（与飞书里的表名完全一致，含编号前缀请照抄）=====
# 首次接真实数据请先跑 npm run inspect 确认表名与字段名
TABLE_STUDENT=学员表
TABLE_CHECKIN=签到表
TABLE_PERIOD=期次表
TABLE_CLASS=班级表
TABLE_SESSION=课次表
TABLE_TRIAL=新客户试听
TABLE_SURVEY=答卷表
TABLE_CONFIRM=确认表
TABLE_GUEST=临时登记表
TABLE_QUESTIONNAIRE=场次问卷表
# 三张报备表：在读 / 新客 / 往期补课
TABLE_REPORT=入校报备表
TABLE_NEW_REPORT=新客入校报备表
TABLE_MAKEUP_REPORT=补课学员入校报备表
TABLE_TEACHER=讲师表
# 每期名册表：{period} 会替换成「期次表.期次名称」，如 金融26期 → 金融26期学员表
TABLE_ROSTER_PATTERN={period}学员表
PERIOD_NAME_FIELD=期次名称

# ===== 课程信息（前端展示；live 下会被课次表覆盖）=====
COURSE_TITLE=增长战略与组织能力
COURSE_PERIOD=第 12 期
COURSE_DATE=11 月 21 日 周六 · 09:00–17:00
COURSE_PLACE=上海 · 静安洲际酒店 3F 宴会厅
COURSE_SPEAKER=王 XX　某咨询合伙人
COURSE_DEADLINE=11-19 18:00
COURSE_WINDOW=08:30 — 17:30

# 课表：决定扫码后落在哪个阶段（北京时间 UTC+8）
# 课前 → 报名确认；签到窗口内 → 现场签到；窗口结束后 → 课后评价
COURSE_DAY=2026-11-21
COURSE_WINDOW_START=08:30
COURSE_WINDOW_END=17:30
# 评价阶段结束日（留空则默认当天 23:59；目前只用于展示，不会自动关闭问卷）
COURSE_SURVEY_END=23:59
COURSE_SURVEY_END_DAY=
# 课次表里「讲师及嘉宾」的字段名
SESSION_TEACHER_FIELD=讲师及嘉宾

# 工作人员入口 /staff 的口令；留空则本机无需口令即可切换阶段
# 注意：live 模式强烈建议设置，否则任何人都能切换场次阶段
ADMIN_TOKEN=

# ===== 字段名覆盖（留空则按内置候选名自动探测）=====
