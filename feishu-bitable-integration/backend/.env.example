# 飞书应用配置
# 在飞书开放平台 (https://open.feishu.cn/) 创建应用获取
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 飞书多维表格配置
# 多维表格URL
FEISHU_BASE_URL=https://digitalsolution.feishu.cn/base/QqE6bIOtgaVkMNsAy8Jc9b86nUf
# 数据表名称
FEISHU_TABLE_NAME=综合报名信息

# 服务器配置
PORT=3000

# 环境变量说明：
# 1. 访问 https://open.feishu.cn/ 创建企业自建应用
# 2. 开启 "多维表格" 权限（bitable:record、bitable:table 等）
# 3. 发布应用并获取 App ID 和 App Secret
# 4. 将应用分享给你的多维表格，赋予编辑权限
